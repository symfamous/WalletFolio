# Environment Variables
# Copy this file to .env.local and fill in your API keys

# ─── Primary Providers ────────────────────────────────────────────

# Zerion API — free at https://developers.zerion.io
ZERION_API_KEY=your_zerion_api_key_here

# OpenSea API - optional production key for strictly screened verified NFT holdings.
# If absent, the server obtains an expiring free-tier key through OpenSea's instant agent-key endpoint.
# Create a higher-throughput key at https://docs.opensea.io/
OPENSEA_API_KEY=your_opensea_api_key_here

# Helius DAS API — free at https://dashboard.helius.dev/signup
HELIUS_API_KEY=your_helius_api_key_here

# Mobula API — free tier for DeFi positions on Solana + EVM
# Sign up at https://mobula.io (free API key)
# Covers: Orca, Raydium, Marinade, Jito, Solend, Kamino, MarginFi, Drift, etc.
MOBULA_API_KEY=your_mobula_api_key_here

# Jupiter Portfolio API — free tier with API key at https://portal.jup.ag
# Best broad Solana DeFi coverage across Marinade, Jito, Raydium, Orca, Solend, Marginfi, Drift, etc.
JUPITER_API_KEY=your_jupiter_api_key_here

# Etherscan V2 API — free at https://etherscan.io
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── Supplemental Providers ──────────────────────────────────────

# Covalent API — free tier: 1M credits/month
# Sign up at https://www.covalenthq.com (free API key)
# Used as EVM DeFi fallback when Zerion is unavailable
COVALENT_API_KEY=your_covalent_api_key_here

# Zapper API — free tier: 100k calls/month
# Sign up at https://zapper.xyz (free API key)
# Used as fallback #1 when Zerion is rate limited (429/502)
# Auth: x-zapper-api-key: {ZAPPER_API_KEY}
ZAPPER_API_KEY=your_zapper_api_key_here

# Moralis Web3 API — free tier: 100 credits/day
# Sign up at https://moralis.io (free API key)
# Used as fallback #2 when Zapper is also unavailable
# Auth: X-API-Key: {MORALIS_API_KEY}
MORALIS_API_KEY=your_moralis_api_key_here

# BitQuery GraphQL API — free tier: 100 credits/day, 10 credits/query
# Sign up at https://dashboard.bitquery.io
# Used for Solana DeFi (Marinade, Raydium, Jito) + supplemental EVM DeFi
# Auth: X-API-KEY header
BITQUERY_API_KEY=your_bitquery_api_key_here

# Perp History Optional Auth-backed Adapters
# These are only used by the isolated /api/perp-history/[address] route.
# They do not affect the live portfolio or perps dashboard.

# Paradex readonly token support
# Docs: https://docs.paradex.trade/docs/trading/api-authentication
PARADEX_EVM_ADDRESS=0x_your_paradex_wallet_here
PARADEX_READONLY_TOKEN=your_paradex_readonly_token_here
PARADEX_API_BASE_URL=https://api.prod.paradex.trade

# Lighter optional read-only token support
# Docs: https://apidocs.lighter.xyz/docs/api-keys
LIGHTER_EVM_ADDRESS=0x_your_lighter_wallet_here
LIGHTER_READONLY_TOKEN=ro:your_lighter_readonly_token_here
LIGHTER_ACCOUNT_INDEX=your_lighter_account_index_here
LIGHTER_API_BASE_URL=https://mainnet.zklighter.elliot.ai

# Extended config recognition
# Docs: https://docs.extended.exchange/ and https://github.com/x10xchange
# The isolated /api/perp-history route uses EXTENDED_API_KEY for read-only
# private GET endpoints. Stark/vault fields are kept for sub-account validation
# and future signed flows.
EXTENDED_API_BASE_URL=https://api.starknet.extended.exchange
EXTENDED_EVM_ADDRESS=0x_your_extended_wallet_here
EXTENDED_API_KEY=your_extended_api_key_here
EXTENDED_PUBLIC_KEY=your_extended_public_key_here
EXTENDED_PRIVATE_KEY=your_extended_private_key_here
EXTENDED_VAULT=your_extended_vault_here
EXTENDED_CLIENT_ID=your_extended_client_id_here
